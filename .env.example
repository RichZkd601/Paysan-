# Copier ce fichier en .env.local et compléter les valeurs.
# Ne JAMAIS commiter .env.local ni aucun fichier contenant une clé SECRÈTE.

# --- Site (public) -------------------------------------------------------
# Nom provisoire de la plateforme (PRODUCT_SPEC §15).
NEXT_PUBLIC_SITE_NAME=PAYSAN
# URL de base : liens partagés, QR codes, canonical, sitemap, liens magiques.
# Le domaine n'est pas arrêté : ne pas imprimer de QR codes définitifs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (public) ---------------------------------------------------
# URL du projet et clé « publishable » (conçue pour être exposée : la
# sécurité repose sur la RLS). Supabase > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://ivsaiyualnpjvhjgvkcs.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_a5N0ZeaoHxra7Wmk-ZssrA_cX-SJ5z1

# --- Secrets serveur (NE PAS préfixer par NEXT_PUBLIC_) -------------------
# Pas utilisés au Lot 1. La clé secrète (sb_secret_… / service_role) ne doit
# exister que dans .env.local et dans les variables d'environnement Vercel.
# SUPABASE_SECRET_KEY=

# --- Tests base de données (local / CI) ----------------------------------
# PostgreSQL 15+ avec PostGIS, connexion superutilisateur. Voir README.
# TEST_DATABASE_URL=postgres://tester:tester@localhost:5432/postgres
