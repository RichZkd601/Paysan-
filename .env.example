# Copier ce fichier en .env.local et compléter les valeurs.
# Ne JAMAIS commiter .env.local ni aucun fichier contenant de vraies clés.

# --- Public (exposé au navigateur) ---------------------------------------
# Nom provisoire de la plateforme (PRODUCT_SPEC §15).
NEXT_PUBLIC_SITE_NAME=PAYSAN
# URL de base : sert aux liens partagés, QR codes, canonical, sitemap.
# Le domaine n'est pas arrêté : ne pas imprimer de QR codes définitifs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Lot 1, pas encore utilisé) --------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret serveur uniquement. Ne jamais préfixer par NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
